+}
+
+:global([data-linux-chrome]) .frame::before {
+  background:
+    linear-gradient(var(--dsw-alias-border-l3), var(--dsw-alias-border-l3))
+      calc(var(--dsh-windows-sidebar-width, 0px) - 1px) 0 / 1px 100% no-repeat,
+    linear-gradient(var(--dsh-linux-sidebar-fill), var(--dsh-linux-sidebar-fill))
+      0 0 / var(--dsh-windows-sidebar-width, 0px) 100% no-repeat,
+    var(--dsw-alias-bg-base);
+}
+
+:global([data-linux-chrome]) .frame[data-sidebar-collapsed]::before {
+  background: var(--dsw-alias-bg-base);
+}
+
+:global([data-linux-chrome]) .sidebarCol {
+  --dsw-specific-sidebar-fill: var(--dsh-linux-sidebar-fill);
+  background: var(--dsh-linux-sidebar-fill);
+  border-right: 1px solid var(--dsw-alias-border-l3);
+}
+
+:global([data-linux-chrome]) .centerCol {
+  border-radius: 0;
+}
