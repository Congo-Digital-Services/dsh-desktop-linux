diff --git a/apps/desktop/src/preload-platform.ts b/apps/desktop/src/preload-platform.ts
index 1e197b0c..caf92803 100644
--- a/apps/desktop/src/preload-platform.ts
+++ b/apps/desktop/src/preload-platform.ts
@@ -2,13 +2,18 @@
 
 import { ipcRenderer } from 'electron'
 import { DESKTOP_IPC } from './ipc.ts'
+import { WINDOWS_TITLEBAR_HEIGHT } from './windows-layout.ts'
 
 /**
  * Sets `data-platform` (e.g. `darwin`) on `<html>`, deferring to DOMContentLoaded
  * when the preload runs before the document root exists.
  */
 export function markDocumentPlatform(): void {
-  const mark = (): void => { document.documentElement.dataset.platform = process.platform }
+  const mark = (): void => {
+    document.documentElement.dataset.platform = process.platform
+    // Linux: frameless window with a slim caption row (same layout as the Windows titlebar).
+    if (process.platform === 'linux') installLinuxWindowChrome()
+  }
   // lib.dom types documentElement non-null, but a preload runs before the
   // document root exists.
   const root = document.documentElement as HTMLElement | null
@@ -31,3 +36,60 @@ export function syncWindowFullscreen(): void {
     else delete root.dataset.fullscreen
   })
 }
+
+const LINUX_CHROME_CSS = `
+html[data-linux-chrome], html[data-linux-chrome] body { background: var(--dsw-alias-bg-base); }
+html[data-linux-chrome] :is(button, a, input, select, textarea, [role='button'], [role='tab'], [contenteditable='true']) {
+  -webkit-app-region: no-drag;
+}
+#dsh-linux-window-controls {
+  position: fixed; top: 0; right: 0; z-index: 1100; height: var(--dsh-windows-titlebar-height);
+  display: flex; align-items: center; gap: 2px; padding-right: 6px; -webkit-app-region: no-drag;
+}
+#dsh-linux-window-controls button {
+  width: 32px; height: 28px; border: 0; border-radius: 6px; padding: 0; margin: 0;
+  display: grid; place-items: center; background: transparent; cursor: default;
+  color: var(--dsw-alias-label-secondary); -webkit-app-region: no-drag;
+}
+#dsh-linux-window-controls button:hover {
+  background: var(--dsw-alias-interactive-bg-hover); color: var(--dsw-alias-label-primary);
+}
+#dsh-linux-window-controls button.close:hover { background: #e5484d; color: #fff; }
+#dsh-linux-window-controls svg { width: 14px; height: 14px; }
+html[data-fullscreen] #dsh-linux-window-controls { display: none; }
+`
+
+const LINUX_CONTROL_ICONS: Record<string, string> = {
+  minimize: '<path d="M3.5 5.5 7 9l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>',
+  maximize: '<path d="M7 2.5 11.5 7 7 11.5 2.5 7z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>',
+  close: '<path d="m3.5 3.5 7 7m0-7-7 7" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>',
+}
+
+/** Linux: caption row marker, sidebar-coloured background and minimize / maximize / close controls. */
+function installLinuxWindowChrome(): void {
+  const root = document.documentElement
+  if (root.hasAttribute('data-linux-chrome')) return
+  root.setAttribute('data-linux-chrome', '')
+  root.dataset.windowsTitlebar = ''
+  root.style.setProperty('--dsh-windows-titlebar-height', `${WINDOWS_TITLEBAR_HEIGHT}px`)
+  const install = (): void => {
+    const style = document.createElement('style')
+    style.textContent = LINUX_CHROME_CSS
+    document.head.append(style)
+    const bar = document.createElement('div')
+    bar.id = 'dsh-linux-window-controls'
+    for (const action of ['minimize', 'maximize', 'close']) {
+      const button = document.createElement('button')
+      button.type = 'button'
+      button.className = action
+      button.title = action === 'minimize' ? 'Minimize' : action === 'maximize' ? 'Maximize' : 'Close'
+      button.setAttribute('aria-label', button.title)
+      button.innerHTML = `<svg viewBox="0 0 14 14" aria-hidden="true">${LINUX_CONTROL_ICONS[action]}</svg>`
+      button.addEventListener('click', () => { ipcRenderer.send('dsh-linux:window-control', action) })
+      bar.append(button)
+    }
+    document.body.append(bar)
+  }
+  if (document.body === null) window.addEventListener('DOMContentLoaded', install)
+  else install()
+}
