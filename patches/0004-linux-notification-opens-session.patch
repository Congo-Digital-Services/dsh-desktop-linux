   }
+  // Linux community build: the desktop preload forwards a notification click as a same-window message.
+  ctx.effect(() => {
+    const onMessage = (event: MessageEvent): void => {
+      const data = event.data as { readonly type?: unknown; readonly sessionId?: unknown } | null
