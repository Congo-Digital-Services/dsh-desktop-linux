diff --git a/apps/desktop/src/linux-open-session.ts b/apps/desktop/src/linux-open-session.ts
new file mode 100644
index 00000000..7df49011
--- /dev/null
+++ b/apps/desktop/src/linux-open-session.ts
@@ -0,0 +1,60 @@
+/** Linux community build: a private local socket that lets a desktop notification open the Session it reports. */
+
+import { chmodSync, mkdirSync, rmSync } from 'node:fs'
+import { createServer, type Server } from 'node:net'
+import { join } from 'node:path'
+
+const SESSION_ID = /^[\w.:-]{1,200}$/
+const MAX_REQUEST_BYTES = 512
+
+/**
+ * Socket path shared with the notification plugin: `$XDG_RUNTIME_DIR/dsh-desktop-linux/open-session.sock`.
+ * @param environment - process environment.
+ * @returns the path, or undefined without a per-user runtime directory.
+ */
+export function linuxOpenSessionSocketPath(environment: NodeJS.ProcessEnv = process.env): string | undefined {
+  const runtime = environment.XDG_RUNTIME_DIR
+  return runtime === undefined || runtime === '' ? undefined : join(runtime, 'dsh-desktop-linux', 'open-session.sock')
+}
+
+/**
+ * Listen for `<session id>\n` requests and pass each valid id to `open`.
+ * The caller must own the Desktop single-instance lock, so a socket left by a crashed run is safe to replace.
+ * @param open - shows the Session in the main window.
+ * @returns a disposer, or undefined when the socket cannot be created.
+ */
+export function listenLinuxOpenSession(open: (sessionId: string) => void): (() => void) | undefined {
+  const path = linuxOpenSessionSocketPath()
+  if (path === undefined) return undefined
+  const directory = join(path, '..')
+  let server: Server
+  try {
+    mkdirSync(directory, { recursive: true, mode: 0o700 })
+    chmodSync(directory, 0o700)
+    rmSync(path, { force: true })
+    server = createServer((socket) => {
+      let request = ''
+      socket.setEncoding('utf8')
+      socket.setTimeout(2000, () => { socket.destroy() })
+      socket.on('data', (chunk: string) => {
+        request += chunk
+        if (request.length > MAX_REQUEST_BYTES) { socket.destroy(); return }
+        const end = request.indexOf('\n')
+        if (end === -1) return
+        const sessionId = request.slice(0, end).trim()
+        socket.end()
+        if (SESSION_ID.test(sessionId)) open(sessionId)
+      })
+      socket.on('error', () => {})
+    })
+    server.on('error', (error) => { console.warn('dsh-linux: open-session socket failed:', error) })
+    server.listen(path, () => { try { chmodSync(path, 0o600) } catch { /* the directory is already private */ } })
+  } catch (error: unknown) {
+    console.warn('dsh-linux: open-session socket unavailable:', error)
+    return undefined
+  }
+  return () => {
+    server.close()
+    rmSync(path, { force: true })
+  }
+}
