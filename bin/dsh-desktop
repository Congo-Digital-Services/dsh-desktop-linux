#!/usr/bin/env bash
# Launch DSH Desktop built by dsh-desktop-linux.
# Optional settings: ~/.config/dsh-desktop-linux/env (KEY=value lines), e.g.
#   DEEPSEEK_API_KEY=sk-...
#   DEEPSEEK_BASE_URL=https://your-relay.example.com/anthropic
set -u
SRC="${DSH_DESKTOP_SRC:-${XDG_DATA_HOME:-$HOME/.local/share}/dsh-desktop-linux/src}"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/dsh-desktop-linux"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/dsh-desktop-linux/desktop.log"

# Node installed through nvm is not on PATH for desktop launchers.
[ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ] && . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1

if [ -f "$CONF/env" ]; then set -a; . "$CONF/env"; set +a; fi
# Share sessions, settings and skills with the dsh CLI.
export DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
export DSH_DESKTOP_OPEN_DEVTOOLS="${DSH_DESKTOP_OPEN_DEVTOOLS:-0}"

[ -x "$SRC/node_modules/.bin/pnpm" ] || { echo "DSH Desktop is not built: run build.sh first." >&2; exit 1; }
mkdir -p "$(dirname "$LOG")"
cd "$SRC" || exit 1
exec "$SRC/node_modules/.bin/pnpm" run start:desktop >>"$LOG" 2>&1
